# Copy to .env.local and fill in values. Never commit .env.local.
# Rotate API keys periodically; revoke and replace if exposed.

# Required for contact form email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
YOUR_EMAIL=

# Cloudflare Turnstile (required in production). Site key is public by design.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional shared rate-limit store. Without these, a hardened in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
